<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- 托盘 NotifyIcon 来自 WinForms -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- 允许在 macOS/Linux 上交叉编译（真机运行仍需 Windows） -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>Folderis</AssemblyName>
    <RootNamespace>Sider</RootNamespace>
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>
    <!-- 版本单一来源：发版时由 build_release.sh 的 FOLDERIS_APP_VERSION 经
         -p:Version 覆盖；AssemblyVersion/FileVersion 一律由它派生，自动更新
         比对的就是这个版本号（NetSparkle 读 AssemblyVersion）。 -->
    <Version>1.1.0</Version>
    <!-- 构建号：发版时由 build_release.sh 的 FOLDERIS_BUILD_VERSION 经 -p:FolderisBuild 注入，
         本地构建显示 dev。跟着 InformationalVersion 进程序集，设置页读的就是它，
         不再有手改常量忘了改的过时构建号。 -->
    <FolderisBuild Condition="'$(FolderisBuild)' == ''">dev</FolderisBuild>
    <InformationalVersion>$(Version)+$(FolderisBuild)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Company>Folderis</Company>
    <Product>Folderis</Product>
  </PropertyGroup>
  <ItemGroup>
    <!-- 自动更新：只取核心包，不引入它自带的 WPF/WinForms 界面（横幅自研） -->
    <PackageReference Include="NetSparkleUpdater.SparkleUpdater" Version="2.3.0" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="UIAutomationClient" />
    <Reference Include="UIAutomationTypes" />
    <!-- 技能工具箱与 macOS 版共用同一份源文件，编译期内嵌，首用时释放到运行时目录 -->
    <EmbeddedResource Include="../../../01-finder-sidebar/skills/skills.py" LogicalName="skills.py" />
    <EmbeddedResource Include="../../../01-finder-sidebar/skills/catalog.txt" LogicalName="catalog.txt" />
    <Resource Include="Assets/app.png" />
    <Resource Include="Assets/clippy.png" />
    <!-- WinForms 只用于托盘 NotifyIcon，全限定调用；去掉隐式 using 避免与 WPF 类型撞名 -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
</Project>
